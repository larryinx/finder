# ── Agent LLM (OpenAI-compatible endpoint) ────────
AGENT_LLM_MODEL=Qwen/Qwen3.6-35B-A3B
AGENT_LLM_BASE_URL=http://localhost:8000/v1
AGENT_LLM_API_KEY=EMPTY
# Provider integration: ``openai_compat`` (default — ChatOpenAI against
# any OpenAI-compatible URL) or ``openrouter`` (ChatOpenRouter against
# https://openrouter.ai/api/v1; ``langchain-openrouter`` round-trips
# reasoning natively).
# AGENT_LLM_PROVIDER=openai_compat
# Per-component overrides. The reflector and curator LLMs fall back to
# the AGENT_LLM_* values above; set these to run them on a different
# model / endpoint / provider.
# REFLECTOR_LLM_MODEL=
# REFLECTOR_LLM_BASE_URL=
# REFLECTOR_LLM_API_KEY=
# REFLECTOR_LLM_PROVIDER=
# CURATOR_LLM_MODEL=
# CURATOR_LLM_BASE_URL=
# CURATOR_LLM_API_KEY=
# CURATOR_LLM_PROVIDER=

# ── OpenRouter provider routing (only honored when AGENT_LLM_PROVIDER=openrouter) ──
# OPENROUTER_PROVIDER=
# OPENROUTER_PROVIDER_FALLBACKS=true

# ── Search tool (MCP server) ──────────────────────────────────────────
# Stand it up with third_party/BrowseComp-Plus/searcher/mcp_server.py or
# any compatible build. Only consumed when the run's tool_provider=mcp
# (default for benchmark=bcp / browsecomp_plus).
AGENT_MCP_URL=http://127.0.0.1:8080/mcp
# ``sse`` (the mcp_server.py default) or ``streamable_http``.
# AGENT_MCP_TRANSPORT=sse

# ── Google Serper (serper.dev) — web search tool ──────────────────────
SERPER_API_KEY=
# Optional failover key; used when the primary runs out of credits.
# SERPER_API_KEY_BACKUP=

# ── Judge LLM (BCP llm_judge scorer) ──────────────────────────────────
# Optional. Set to point the BCP grader at a different (typically stronger) model.
# EVAL_JUDGE_MODEL=
# EVAL_JUDGE_BASE_URL=
# EVAL_JUDGE_API_KEY=
# ``openai_compat`` | ``openrouter``; falls back to AGENT_LLM_PROVIDER.
# EVAL_JUDGE_PROVIDER=

# ── LangSmith ──────────────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="TTL-Search"

# ── W&B / Weave tracing ───────────────────────────────────────────────
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=

# Optional Weave knobs
WEAVE_DISABLED=true
WEAVE_CAPTURE_CODE=false

# Per-phase gates (override the global WEAVE_DISABLED only for the named phase).
# Useful when you want to skip a noisy phase while keeping the rest traced.
#  - WEAVE_DISABLED_HIEXP_ROLLOUT: skip sample_rollouts.py traces (the K×N
#    rollout calls during HEK build). The orchestrator (build_hek.py)
#    still runs, so the e1/e2 jsonl Artifact upload at the end is
#    *not* affected.
#  - WEAVE_DISABLED_HIEXP_EVAL: skip run_eval.py (HiExp baseline / +HEK eval).
#  - WEAVE_DISABLED_ACE_OFFLINE: skip ACE offline run (training + final test).
#                                Playbook checkpoint Artifacts also gated
#                                because they're uploaded from the same process.
#  - WEAVE_DISABLED_ACE_ONLINE: skip ACE online run (per-sample predict + update).
#  - WEAVE_DISABLED_HEK_BUILD: skip the build_hek.py orchestrator. This
#                              also gates the HEK Artifact upload, so use
#                              WEAVE_DISABLED_HIEXP_ROLLOUT instead when you
#                              just want to silence rollouts.
# WEAVE_DISABLED_HIEXP_ROLLOUT=
# WEAVE_DISABLED_HIEXP_EVAL=
# WEAVE_DISABLED_ACE_OFFLINE=
# WEAVE_DISABLED_ACE_ONLINE=
# WEAVE_DISABLED_HEK_BUILD=
